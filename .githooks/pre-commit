#!/usr/bin/env bash
set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"
cd "${repository_root}"

# Check the exact index snapshot. Neither formatting nor unrelated dirty or
# partially staged working copies may be changed by a commit hook.
snapshot="$(mktemp -d "${TMPDIR:-/tmp}/ic-timers-pre-commit.XXXXXX")"
trap 'rm -rf -- "${snapshot}"' EXIT
git checkout-index --all --prefix="${snapshot}/"
if ! make --no-print-directory -C "${snapshot}" fmt-check >"${snapshot}/format.log" 2>&1; then
    sed -n '1,240p' "${snapshot}/format.log" >&2
    echo 'Staged formatting check failed. Format and stage the intended changes, then retry.' >&2
    exit 1
fi

echo 'Staged formatting check passed.'
